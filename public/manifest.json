{
  "manifest_version": 3,
  "name": "TabCarry — Save & Restore Tabs",
  "version": "1.0.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "tabGroups", "storage"],
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabCarry",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "save-session": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "__MSG_saveCommand__"
    },
    "open-library": { "description": "__MSG_libraryCommand__" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; base-uri 'none'"
  }
}
